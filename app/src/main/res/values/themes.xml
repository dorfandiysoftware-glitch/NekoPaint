<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NekoPaint" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="popupMenuStyle">@style/NekoPopupMenu</item>
        <item name="android:popupMenuStyle">@style/NekoPopupMenu</item>
    </style>

    <style name="NekoPopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_bg</item>
        <item name="android:popupElevation">8dp</item>
    </style>
</resources>
